# MES Copilot — environment configuration (placeholders only, never commit a real key)
# Copy to .env locally or export in your shell / host (Render) env settings.

# Meta Model API (Llama API) key — server-side only. Without it the app runs
# in STUB mode: deterministic, clearly-marked mock responses, same JSON shapes.
META_API_KEY=your-meta-llama-api-key-here

# Optional overrides (defaults shown):
# LLAMA_API_BASE_URL=https://api.llama.com/v1
# LLM_TEXT_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# LLM_VISION_MODEL=Llama-4-Scout-17B-16E-Instruct-FP8
# PORT=3000
